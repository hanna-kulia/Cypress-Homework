{
  "name": "cypress-homework",
  "version": "1.0.0",
  "description": "",
  "main": "cypress.config.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "clean:reports": "rm -rf cypress/results/*",
    "cy:run:qauto": "cypress run --config-file cypress.config.qauto.js --spec 'cypress/e2e/garageAndExpenses.cy.js'",
    "cy:run:qauto2": "cypress run --config-file cypress.config.qauto2.js --spec 'cypress/e2e/garageAndExpenses.cy.js'",
    "report:merge": "npx mochawesome-merge cypress/results/*.json > cypress/results/combined-report.json",
    "report:generate": "npx marge cypress/results/combined-report.json --reportDir cypress/results --inline",
    "report": "npm run report:merge && npm run report:generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanna-kulia/Cypress-Homework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hanna-kulia/Cypress-Homework/issues"
  },
  "homepage": "https://github.com/hanna-kulia/Cypress-Homework#readme",
  "devDependencies": {
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.0",
    "husky": "^9.1.7",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "prettier": "^3.9.6"
  }
}
